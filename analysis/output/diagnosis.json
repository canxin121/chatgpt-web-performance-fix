  "recommendedChanges": [
    {
      "id": "remove-global-scroll-geometry-scan",
      "reason": "The current rich-text warmer listens to every captured scroll, including sidebar scrolling, and reads all cold-node geometry."
    },
    {
      "id": "use-browser-managed-richtext-observation",
      "reason": "Use IntersectionObserver and idle queues instead of getBoundingClientRect loops on scroll."
    },
    {
      "id": "offload-large-json-work",
      "reason": "Parse, merge, filter, and stringify paginated payloads in a Worker so the sidebar remains responsive."
    },
    {
      "id": "bound-cursor-completion",
      "reason": "Reuse completed semantic-turn pages and avoid repeated exponential cursor probes for one manual click."
    },
    {
      "id": "instrument-fix-overhead",
      "reason": "Add diagnostics for optimizer worker time, main-thread handoff, mutation scans, and rich-block activations."
    }
  ],
